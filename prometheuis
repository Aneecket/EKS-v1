apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: prom-efs-sc
provisioner: efs.csi.aws.com
parameters:
  provisioningMode: efs-ap
  fileSystemId: fs-0b3edf47b39763f97
  basePath: "/eks"
  directoryPerms: "750"
  gidRangeStart: "1000"
  gidRangeEnd: "2000"
mountOptions:
  - tls
reclaimPolicy: Retain
volumeBindingMode: Immediate




